"""The library's part of a voice pipeline: the spans to cut, their cache key, the LIP from
Rhubarb's cues, and the voice file the game plays. ffmpeg and Rhubarb stay the caller's."""

from .. import Lip

LEAD: float
WAV_HEADER: bytes

class Take:
    def __init__(self, name: str, hash: str, segments: list[tuple[float, float]]) -> None: ...
    @staticmethod
    def from_transcript(name: str, audio: bytes, transcript: str) -> Take:
        """From AWS Transcribe JSON; RE1412 without `results.audio_segments`."""
    @property
    def name(self) -> str: ...
    @property
    def hash(self) -> str: ...
    @property
    def segments(self) -> list[tuple[float, float]]: ...

class Line:
    def __init__(
        self, resref: str, take: str, text: str, first: int | None = None, last: int | None = None
    ) -> None: ...
    @property
    def resref(self) -> str: ...
    @property
    def take(self) -> str: ...
    @property
    def text(self) -> str: ...
    @property
    def first(self) -> int | None: ...
    @property
    def last(self) -> int | None: ...

class Span:
    @property
    def resref(self) -> str: ...
    @property
    def take(self) -> str: ...
    @property
    def text(self) -> str: ...
    @property
    def start(self) -> float: ...
    @property
    def end(self) -> float: ...
    @property
    def key(self) -> str: ...
    def start_text(self) -> str: ...
    def end_text(self) -> str: ...

def spans(lines: list[Line], takes: list[Take], lead: float = ...) -> list[Span]:
    """RE0101, RE1411 (two lines of one resref), RE1410 (a take or segments not held)."""

def take_cues(json: str) -> Lip:
